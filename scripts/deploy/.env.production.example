# Variables a ajouter au .env de PRODUCTION (/home/ubuntu/salonista/.env).
#
# Ce fichier ne liste que les variables des promos WhatsApp (novembre 2026).
# Les autres (DATABASE_URL, NEXTAUTH_*, SMTP_*, META_*, NEXT_PUBLIC_SALONISTA_*)
# sont decrites dans CLAUDE.md, section « Required server .env ».
#
# Apres modification : `pm2 reload ecosystem.config.js --update-env`.

# Cle de chiffrement des jetons WhatsApp en base (AES-256-GCM).
# 32 octets en base64 : `openssl rand -base64 32`. A GENERER UNE FOIS et a
# sauvegarder hors du serveur : la perdre rend illisibles tous les jetons
# enregistres (il faudrait les ressaisir dans /superadmin).
CLE_CHIFFREMENT_SECRETS=

# Secret du cron qui declenche le moteur d'envoi chaque minute.
# `openssl rand -hex 32`. Sans lui, le moteur ne tourne pas.
CRON_SECRET=

# Version de l'API Graph de Meta, sans la coder en dur. Verifier la derniere
# sur https://developers.facebook.com/docs/graph-api/changelog
# (v27.0 au 12/11/2026).
WHATSAPP_GRAPH_VERSION=v27.0

# « App Secret » de l'application Meta (Parametres de l'app > De base).
# Sert a verifier la signature des notifications du webhook.
WHATSAPP_APP_SECRET=

# Jeton de verification du webhook, choisi librement (`openssl rand -hex 16`)
# et recopie dans la configuration du webhook chez Meta.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# 1 = les salons de DEMONSTRATION (ProviderProfile.demo) sans connexion
# WhatsApp envoient en simulation : aucun message reel, bandeau « Mode demo ».
# Un vrai salon n'est JAMAIS concerne, meme avec 1 : il voit « WhatsApp n'est
# pas encore connecte ». Peut donc rester a 1 en production pour les demos.
PROMOS_SIMULATION=
