+/* Page d'accueil Salonista — direction editoriale ivoire / espresso / bordeaux.
+   Cette feuille n'est importee que par src/app/page.tsx : elle ne part donc
+   que dans le bundle de la route "/", jamais dans le reste du site. */
+
+:root{
+  --ivoire:#F7F3ED;
+  --ivoire-2:#EFE7DC;
+  --espresso:#241C18;
+  --espresso-2:#1A1310;
+  --taupe:#6E6157;
+  --bordeaux:#6B1F35;
+  --bordeaux-2:#571828;
+  --blush:#E7D3CD;
+  --champagne:#C0A177;
+  --hair:#DED3C6;
+
+  --serif:"Instrument Serif", "Times New Roman", serif;
+  --ui:"Archivo", system-ui, -apple-system, sans-serif;
+  --ar:"Noto Kufi Arabic", "Archivo", system-ui, sans-serif;
+
+  --gut:clamp(20px, 5vw, 76px);
+  --maxw:1400px;
+  --ease:cubic-bezier(.16,1,.3,1);
+}
+
+*{box-sizing:border-box;}
+html{scroll-behavior:smooth;}
+/* Le layout racine pose deja des classes Tailwind sur <body> (bg-brand-cream,
+   text-brand-ink) : une regle d'element ne les battrait pas. On habille donc
+   le conteneur de la page, dont tout le reste herite. */
+body{overflow-x:hidden;}
+.lp-root{
+  background:var(--ivoire);color:var(--espresso);
+  font-family:var(--ui);font-size:16px;font-weight:400;line-height:1.6;
