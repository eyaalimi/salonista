generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CLIENT
  INFLUENCER
  PROVIDER
  ADMIN
}

enum Category {
  COIFFURE
  ESTHETIQUE
  ONGLERIE
  MASSAGE
  PARFUMERIE
  AUTRE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum CommissionStatus {
  PENDING
  PAID
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum CollabStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum EmployeeRole {
  OWNER
  MANAGER
  CASHIER
  STYLIST
}

enum SubscriptionModule {
  POS
  REWARDS
}

enum SubscriptionStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
  TRIAL
}

enum SaleStatus {
  DRAFT
  PENDING_SYNC
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  VOIDED
}

enum SaleItemKind {
  SERVICE
  PRODUCT
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

enum RefundReason {
  CUSTOMER_REQUEST
  SERVICE_ISSUE
  PRODUCT_DEFECT
  PRICING_ERROR
  OTHER
}

enum StockMovementReason {
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN
  LOSS
  SYNC_NEGATIVE
}

enum CashDrawerStatus {
  OPEN
  CLOSED
  RECONCILED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  phone         String?
  passwordHash  String?
  role          Role      @default(CLIENT)
  name          String?
  avatar        String?
  emailVerified         DateTime?
  emailVerifyToken      String?   @unique
  emailVerifyExpires    DateTime?
  passwordResetToken    String?   @unique
  passwordResetExpires  DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  providerProfile   ProviderProfile?
  influencerProfile InfluencerProfile?
  bookings          Booking[]
  reviews           Review[]
  accounts          Account[]
  sessions          Session[]
  customer          Customer?
  employeeAccounts  SalonEmployee[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ProviderProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  salonName       String
  category        Category
  description     String?
  address         String?
  city            String?
  lat             Float?
  lng             Float?
  phone           String?
  photos          String[]
  openingHours    Json?
  matriculeFiscal String?
  receiptFooter   String?
  verified        Boolean  @default(false)
  createdAt       DateTime @default(now())

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  offers                Offer[]
  collaborationRequests CollaborationRequest[]
  employees             SalonEmployee[]
  subscriptions         SalonSubscription[]
  products              Product[]
  sales                 Sale[]
  cashDrawerSessions    CashDrawerSession[]
}

model InfluencerProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  instagramHandle String
  followersCount  Int      @default(0)
  category        String?
  bio             String?
  verified        Boolean  @default(false)
  totalEarnings   Decimal  @default(0) @db.Decimal(10, 3)
  pendingBalance  Decimal  @default(0) @db.Decimal(10, 3)
  createdAt       DateTime @default(now())

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackingLinks         TrackingLink[]
  payouts               Payout[]
  collaborationRequests CollaborationRequest[]
}

model Offer {
  id              String    @id @default(cuid())
  providerId      String
  title           String
  description     String?
  originalPrice   Decimal   @db.Decimal(10, 3)
  discountPrice   Decimal   @db.Decimal(10, 3)
  category        Category
  photos          String[]
  durationMinutes Int       @default(60)
  taxRate         Decimal   @default(19.00) @db.Decimal(5, 2)
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())

  provider              ProviderProfile             @relation(fields: [providerId], references: [id], onDelete: Cascade)
  trackingLinks         TrackingLink[]
  bookingItems          BookingItem[]
  reviews               Review[]
  slots                 TimeSlot[]
  collaborationOffers   CollaborationOffer[]
  saleItems             SaleItem[]
}

model TimeSlot {
  id          String   @id @default(cuid())
  offerId     String
  startTime   DateTime
  endTime     DateTime
  capacity    Int      @default(1)
  bookedCount Int      @default(0)
  createdAt   DateTime @default(now())

  offer        Offer         @relation(fields: [offerId], references: [id], onDelete: Cascade)
  bookingItems BookingItem[]

  @@index([offerId, startTime])
}

model TrackingLink {
  id               String   @id @default(cuid())
  influencerId     String
  offerId          String
  token            String   @unique
  clicksCount      Int      @default(0)
  conversionsCount Int      @default(0)
  createdAt        DateTime @default(now())

  influencer         InfluencerProfile   @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  offer              Offer               @relation(fields: [offerId], references: [id], onDelete: Cascade)
  clicks             Click[]
  collaborationOffer CollaborationOffer?
}

model Click {
  id             String   @id @default(cuid())
  trackingLinkId String
  clientIp       String?
  userAgent      String?
  referrer       String?
  clickedAt      DateTime @default(now())
  converted      Boolean  @default(false)
  bookingId      String?  @unique

  trackingLink TrackingLink @relation(fields: [trackingLinkId], references: [id], onDelete: Cascade)
  booking      Booking?     @relation(fields: [bookingId], references: [id])
}

model Booking {
  id                 String        @id @default(cuid())
  clientId           String
  customerId         String?
  walkIn             Boolean       @default(false)
  createdViaPos      Boolean       @default(false)
  phantom            Boolean       @default(false)
  assignedEmployeeId String?
  status             BookingStatus @default(PENDING)
  paymentStatus      PaymentStatus @default(UNPAID)
  totalPrice         Decimal       @db.Decimal(10, 3)
  notes              String?
  qrCode             String?       @unique
  qrVerified         Boolean       @default(false)
  qrVerifiedAt       DateTime?
  paidAt             DateTime?
  createdAt          DateTime      @default(now())

  client             User           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  customer           Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedEmployee   SalonEmployee? @relation("BookingAssignedEmployee", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  items              BookingItem[]
  click              Click?
  commission         Commission?
  review             Review?
  sale               Sale?

  @@index([customerId])
  @@index([assignedEmployeeId])
}

model BookingItem {
  id                 String  @id @default(cuid())
  bookingId          String
  offerId            String
  slotId             String
  unitPrice          Decimal @db.Decimal(10, 3)
  assignedEmployeeId String?

  booking          Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  offer            Offer          @relation(fields: [offerId], references: [id], onDelete: Cascade)
  slot             TimeSlot       @relation(fields: [slotId], references: [id], onDelete: Restrict)
  assignedEmployee SalonEmployee? @relation("BookingItemAssignedEmployee", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([assignedEmployeeId])
}

model Commission {
  id               String           @id @default(cuid())
  bookingId        String           @unique
  providerAmount   Decimal          @db.Decimal(10, 3)
  influencerAmount Decimal?         @db.Decimal(10, 3)
  platformAmount   Decimal          @db.Decimal(10, 3)
  status           CommissionStatus @default(PENDING)
  createdAt        DateTime         @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Payout {
  id           String       @id @default(cuid())
  influencerId String
  amount       Decimal      @db.Decimal(10, 3)
  status       PayoutStatus @default(PENDING)
  paidAt       DateTime?
  createdAt    DateTime     @default(now())

  influencer InfluencerProfile @relation(fields: [influencerId], references: [id], onDelete: Cascade)
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  clientId  String
  offerId   String
  bookingId String   @unique
  createdAt DateTime @default(now())

  client  User    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  offer   Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model CollaborationRequest {
  id             String       @id @default(cuid())
  providerId     String
  influencerId   String
  commissionPct  Decimal      @db.Decimal(5, 2)
  durationDays   Int
  message        String?
  status         CollabStatus @default(PENDING)
  createdAt      DateTime     @default(now())
  respondedAt    DateTime?

  provider     ProviderProfile      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  influencer   InfluencerProfile    @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  offers       CollaborationOffer[]

  @@index([providerId, status])
  @@index([influencerId, status])
}

model CollaborationOffer {
  id             String  @id @default(cuid())
  collabId       String
  offerId        String
  trackingLinkId String? @unique

  collab       CollaborationRequest @relation(fields: [collabId], references: [id], onDelete: Cascade)
  offer        Offer                @relation(fields: [offerId], references: [id], onDelete: Cascade)
  trackingLink TrackingLink?        @relation(fields: [trackingLinkId], references: [id], onDelete: SetNull)

  @@unique([collabId, offerId])
  @@index([offerId])
}

model Customer {
  id           String    @id @default(cuid())
  phone        String    @unique
  firstName    String?
  lastName     String?
  email        String?
  birthday     DateTime?
  notes        String?
  userId       String?   @unique
  firstSalonId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  bookings Booking[]
  sales    Sale[]

  @@index([phone])
  @@index([firstSalonId])
}

model SalonEmployee {
  id          String       @id @default(cuid())
  providerId  String
  userId      String?
  displayName String
  phone       String?
  email       String?
  pinHash     String?
  role        EmployeeRole @default(CASHIER)
  permissions Json?
  active      Boolean      @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  provider           ProviderProfile     @relation(fields: [providerId], references: [id], onDelete: Cascade)
  user               User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  bookingsLed        Booking[]           @relation("BookingAssignedEmployee")
  itemsLed           BookingItem[]       @relation("BookingItemAssignedEmployee")
  salesRung          Sale[]
  saleItemsAssigned  SaleItem[]          @relation("SaleItemAssignedEmployee")
  tipAllocations     TipAllocation[]     @relation("TipAllocationEmployee")
  refundsIssued      Refund[]            @relation("RefundEmployee")
  stockMovements     StockMovement[]
  cashDrawerSessions CashDrawerSession[] @relation("CashDrawerEmployee")

  @@index([providerId, active])
  @@index([userId])
}

model SalonSubscription {
  id                String             @id @default(cuid())
  providerId        String
  module            SubscriptionModule
  status            SubscriptionStatus @default(ACTIVE)
  activatedAt       DateTime           @default(now())
  expiresAt         DateTime?
  activatedByUserId String?
  pricingSnapshot   Json?
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, module])
  @@index([status])
}

model Product {
  id                String   @id @default(cuid())
  providerId        String
  name              String
  description       String?
  category          String?
  sku               String
  barcode           String?
  purchasePrice     Decimal  @db.Decimal(10, 3)
  salePrice         Decimal  @db.Decimal(10, 3)
  taxRate           Decimal  @default(19.00) @db.Decimal(5, 2)
  stockQuantity     Int      @default(0)
  lowStockThreshold Int      @default(5)
  photo             String?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  provider       ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  saleItems      SaleItem[]
  stockMovements StockMovement[]
  refundItems    RefundItem[]

  @@unique([providerId, sku])
  @@unique([providerId, barcode])
  @@index([providerId, active])
  @@index([barcode])
}

model StockMovement {
  id             String              @id @default(cuid())
  productId      String
  delta          Int
  reason         StockMovementReason
  saleId         String?
  refundId       String?
  employeeId     String?
  note           String?
  requiresReview Boolean             @default(false)
  createdAt      DateTime            @default(now())

  product  Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  sale     Sale?          @relation(fields: [saleId], references: [id], onDelete: SetNull)
  refund   Refund?        @relation(fields: [refundId], references: [id], onDelete: SetNull)
  employee SalonEmployee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([requiresReview])
}

model Sale {
  id                String     @id @default(cuid())
  providerId        String
  customerId        String?
  employeeId        String
  bookingId         String?    @unique
  receiptNumber     String
  status            SaleStatus @default(DRAFT)

  subtotal          Decimal  @db.Decimal(10, 3)
  discountAmount    Decimal  @default(0) @db.Decimal(10, 3)
  discountIsPercent Boolean  @default(false)
  discountValue     Decimal? @db.Decimal(10, 3)
  taxTotal          Decimal  @db.Decimal(10, 3)
  tipTotal          Decimal  @default(0) @db.Decimal(10, 3)
  total             Decimal  @db.Decimal(10, 3)
  refundedTotal     Decimal  @default(0) @db.Decimal(10, 3)

  notes String?

  offlineId     String?   @unique
  syncedAt      DateTime?
  syncConflicts Json?

  createdAt DateTime  @default(now())
  closedAt  DateTime?
  updatedAt DateTime  @updatedAt

  provider       ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  employee       SalonEmployee   @relation(fields: [employeeId], references: [id])
  booking        Booking?        @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  items          SaleItem[]
  payments       Payment[]
  tipAllocations TipAllocation[]
  refunds        Refund[]
  stockMovements StockMovement[]

  @@unique([providerId, receiptNumber])
  @@index([providerId, status, createdAt])
  @@index([customerId])
  @@index([employeeId])
}

model SaleItem {
  id                 String       @id @default(cuid())
  saleId             String
  kind               SaleItemKind
  offerId            String?
  productId          String?
  assignedEmployeeId String?

  nameSnapshot    String
  priceSnapshot   Decimal @db.Decimal(10, 3)
  taxRateSnapshot Decimal @db.Decimal(5, 2)
  quantity        Int     @default(1)

  discountAmount    Decimal  @default(0) @db.Decimal(10, 3)
  discountIsPercent Boolean  @default(false)
  discountValue     Decimal? @db.Decimal(10, 3)

  lineSubtotal  Decimal @db.Decimal(10, 3)
  lineTaxAmount Decimal @db.Decimal(10, 3)
  lineTotal     Decimal @db.Decimal(10, 3)

  refundedQuantity Int @default(0)

  createdAt DateTime @default(now())

  sale             Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  offer            Offer?         @relation(fields: [offerId], references: [id], onDelete: SetNull)
  product          Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  assignedEmployee SalonEmployee? @relation("SaleItemAssignedEmployee", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  refundItems      RefundItem[]

  @@index([saleId])
}

model Payment {
  id                   String        @id @default(cuid())
  saleId               String
  method               PaymentMethod
  amount               Decimal       @db.Decimal(10, 3)
  reference            String?
  cashDrawerSessionId  String?
  createdAt            DateTime      @default(now())

  sale              Sale               @relation(fields: [saleId], references: [id], onDelete: Cascade)
  cashDrawerSession CashDrawerSession? @relation(fields: [cashDrawerSessionId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([cashDrawerSessionId])
}

model TipAllocation {
  id         String   @id @default(cuid())
  saleId     String
  employeeId String
  amount     Decimal  @db.Decimal(10, 3)
  createdAt  DateTime @default(now())

  sale     Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  employee SalonEmployee @relation("TipAllocationEmployee", fields: [employeeId], references: [id])

  @@index([saleId])
  @@index([employeeId])
}

model Refund {
  id           String        @id @default(cuid())
  saleId       String
  employeeId   String
  reason       RefundReason
  notes        String?
  totalAmount  Decimal       @db.Decimal(10, 3)
  refundMethod PaymentMethod
  reference    String?
  createdAt    DateTime      @default(now())

  sale           Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  employee       SalonEmployee   @relation("RefundEmployee", fields: [employeeId], references: [id])
  items          RefundItem[]
  stockMovements StockMovement[]

  @@index([saleId])
}

model RefundItem {
  id             String   @id @default(cuid())
  refundId       String
  saleItemId     String
  productId      String?
  quantity       Int
  amountRefunded Decimal  @db.Decimal(10, 3)
  restock        Boolean  @default(true)
  createdAt      DateTime @default(now())

  refund   Refund   @relation(fields: [refundId], references: [id], onDelete: Cascade)
  saleItem SaleItem @relation(fields: [saleItemId], references: [id])
  product  Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([refundId])
  @@index([saleItemId])
}

model SaleSequence {
  providerId String
  date       DateTime
  counter    Int      @default(0)

  @@id([providerId, date])
}

model CashDrawerSession {
  id           String           @id @default(cuid())
  providerId   String
  employeeId   String
  status       CashDrawerStatus @default(OPEN)

  openedAt     DateTime  @default(now())
  closedAt     DateTime?
  reconciledAt DateTime?

  openingFloat Decimal  @db.Decimal(10, 3)
  closingCount Decimal? @db.Decimal(10, 3)
  expectedCash Decimal? @db.Decimal(10, 3)
  variance     Decimal? @db.Decimal(10, 3)

  openingNotes String?
  closingNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  employee SalonEmployee   @relation("CashDrawerEmployee", fields: [employeeId], references: [id])
  payments Payment[]

  @@index([providerId, status])
  @@index([employeeId, status])
  @@index([openedAt])
}
